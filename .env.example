# Copy this file to ".env" and fill in at least one key, then restart the Expo
# server (`npx expo start --clear`) — keys are read at build time, so a running
# server will not pick up edits to this file.
#
# The app only ever shows real API data. Without a key the provider is disabled
# and the screen tells you which variable is missing.
#
# NOTE: anything prefixed EXPO_PUBLIC_ is embedded in the JS bundle and is
# readable by anyone who installs the app. That is fine for a personal build,
# but do not ship these keys in a public release.

# RentCast — property records with beds/baths/sqft/year built/last sale/owner.
# Best source for the AR walk. Free tier: https://app.rentcast.io/app/api
EXPO_PUBLIC_RENTCAST_API_KEY=

# Zillow via RapidAPI (unofficial scraper) — for-sale listings only, no owner
# data. Subscribe to zillow-com1: https://rapidapi.com/apimaker/api/zillow-com1
EXPO_PUBLIC_RAPIDAPI_KEY=
